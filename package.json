{
  "name": "grocery-compare",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,fetcher -c cyan,magenta \"npm run dev -w @gc/web\" \"npm run dev -w @gc/fetcher\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
